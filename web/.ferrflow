{
  "$schema": "https://ferrflow.com/schema/ferrflow.json",
  "workspace": {
    "tagTemplate": "v{version}",
    "skipCi": true,
    "releaseCommitMode": "pr",
    "autoMergeReleases": true,
    "branches": [
      { "name": "main", "channel": false },
      { "name": "feat/*", "channel": "dev", "prereleaseIdentifier": "short-hash" }
    ]
  },
  "package": [
    {
      "name": "web",
      "path": ".",
      "changelog": "CHANGELOG.md",
      "sharedPaths": ["src/"],
      "versionedFiles": [
        { "path": "package.json", "format": "json" }
      ]
    }
  ]
}
