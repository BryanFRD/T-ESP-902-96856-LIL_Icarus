{
  "name": "vite-project",
  "private": true,
  "version": "1.32.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "local": "vite --mode sandbox",
    "prod": "vite --mode production",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "type:check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "tsx scripts/check-i18n.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "validate": "npm-run-all --parallel type:check i18n:check test:run format:check \"lint -- --max-warnings 0\"",
    "prepare": "husky install",
    "commitlint": "commitlint --edit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "postinstall": "npx playwright install"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint --edit $HUSKY_GIT_PARAMS"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@faker-js/faker": "^10.1.0",
    "@fontsource-variable/figtree": "^5.2.10",
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/vite": "^4.1.7",
    "@tanstack/react-query": "^5.76.2",
    "@types/react-image-crop": "^8.1.6",
    "axios": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.15.0",
    "i18next": "^25.8.4",
    "i18next-browser-languagedetector": "^8.1.0",
    "i18next-resources-to-backend": "^1.2.1",
    "lucide-react": "^0.511.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-circle-flags": "^0.0.27",
    "react-country-flag": "^3.1.0",
    "react-day-picker": "^9.13.2",
    "react-dom": "^19.2.4",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.71.1",
    "react-hot-toast": "^2.5.2",
    "react-i18next": "^16.5.4",
    "react-image-crop": "^11.0.10",
    "react-router-dom": "^7.6.0",
    "react-social-icons": "^6.24.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.7",
    "url-slug": "^4.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.0.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.25.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/gitlab": "^13.2.9",
    "@storybook/addon-a11y": "^9.0.3",
    "@storybook/addon-docs": "^9.0.3",
    "@storybook/addon-onboarding": "^9.0.3",
    "@storybook/addon-vitest": "^9.0.3",
    "@storybook/react-vite": "^9.0.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/i18next": "^12.1.0",
    "@types/node": "^22.15.21",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/react-i18next": "^7.8.3",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/browser": "^3.1.4",
    "@vitest/coverage-v8": "^3.1.4",
    "eslint": "^9.25.0",
    "eslint-plugin-only-warn": "^1.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-storybook": "^9.0.3",
    "globals": "^16.0.0",
    "happy-dom": "^20.0.11",
    "husky": "^9.1.7",
    "i18next-cli": "^1.41.4",
    "jsdom": "^27.2.0",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.52.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "semantic-release": "^24.2.9",
    "shadcn": "^3.8.4",
    "storybook": "^9.0.3",
    "tsx": "^4.19.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
