FROM rust:1.91.0-bookworm AS builder

RUN apt-get update && \
    apt-get install -y \
    build-essential \
    pkg-config \
    libpq-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY derive/ derive/
COPY shared/ shared/
COPY agent/ agent/
COPY server/ server/

# Build the Linux agent
RUN cargo build --release -p agent

# Build the Linux server
RUN cargo build --release -p server

FROM debian:bookworm-slim AS runner

RUN apt-get update && \
    apt-get install -y \
    libpq5 \
    openssl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

WORKDIR /app

COPY --from=builder /app/target/release/server ./server
COPY --from=builder /app/target/release/agent ./agent.exe

RUN chmod +x server

EXPOSE 8080

CMD ["./server"]
