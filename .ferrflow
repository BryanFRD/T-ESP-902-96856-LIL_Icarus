{
  "$schema": "https://ferrflow.com/schema/ferrflow.json",
  "workspace": {
    "forge": "gitlab",
    "tagTemplate": "v{version}",
    "skipCi": true,
    "branches": [
      { "name": "main", "channel": false },
      { "name": "*", "channel": "dev", "prereleaseIdentifier": "short-hash" }
    ]
  },
  "package": [
    {
      "name": "app",
      "path": ".",
      "changelog": "CHANGELOG.md",
      "sharedPaths": ["server/src/", "agent/src/", "shared/src/"],
      "versionedFiles": [
        { "path": "server/Cargo.toml", "format": "toml" },
        { "path": "agent/Cargo.toml", "format": "toml" },
        { "path": "shared/Cargo.toml", "format": "toml" }
      ]
    }
  ]
}
